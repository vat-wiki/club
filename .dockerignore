# Dockerfile 不再 COPY 源码（直接 npm install -g club-serve），这些排除项仅用于
# 缩小发往 daemon 的 build context（整个 context 仍会被打包发送）。
node_modules
**/node_modules
**/dist
**/*.tsbuildinfo

# Git / 编辑器 / 自动化产物
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# club 运行时数据 —— 绝不进镜像
*.db
*.db-shm
*.db-wal

# 仓库里的非运行时目录
.claude
.playwright
.playwright-cli
.ux-review
docs
.pd-docs
DESIGN_REVIEW.md

# Dockerfile 自身与 compose（不进镜像）
Dockerfile
.dockerignore
docker-compose.yml
