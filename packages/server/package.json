{
  "name": "club-serve",
  "version": "0.1.0",
  "type": "module",
  "description": "club backend — Hono + SQLite + SPA host. Run a full club with `npx club-serve`.",
  "repository": {
    "type": "git",
    "url": "https://github.com/vat-wiki/club.git",
    "directory": "packages/server"
  },
  "bin": {
    "club-serve": "bin/club-serve.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup && npm run copy-assets",
    "copy-assets": "node -e \"require('node:fs').cpSync('src/public','dist/public',{recursive:true})\"",
    "copy-web-dist": "node -e \"const fs=require('node:fs'),p=require('node:path');try{fs.cpSync(p.join('..','web','dist'),p.join('dist','public','spa'),{recursive:true})}catch(e){console.warn('[server] web dist not built; skipping SPA copy')}\"",
    "prepack": "npm run copy-web-dist",
    "start": "node bin/club-serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.6.14",
    "image-size": "^2.0.2",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@club/shared": "*",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}